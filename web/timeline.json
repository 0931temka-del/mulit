  {
   "i": 4,
   "t0": 56.044082,
   "D": 20.924082,
   "sentences": [
    {
     "k": 1,
     "t0": 56.044082,
     "t1": 57.804082,
     "text": "Соседка отнесла трубку бабушке."
    },
    {
     "k": 2,
     "t0": 58.164082,
     "t1": 59.804082,
     "text": "Это ты, мой хороший?"
    },
    {
     "k": 3,
     "t0": 59.924082000000006,
     "t1": 61.004082000000004,
     "text": "сказала бабушка."
    },
    {
     "k": 4,
     "t0": 61.284082000000005,
     "t1": 62.204082,
     "text": "Ничего."
    },
    {
     "k": 5,
     "t0": 62.257082000000004,
     "t1": 63.004082000000004,
     "text": "Ты же занят."
    },
    {
     "k": 6,
     "t0": 63.204082,
     "t1": 64.284082,
     "text": "Я всё понимаю."
    },
    {
     "k": 7,
     "t0": 64.50408200000001,
     "t1": 66.524082,
     "text": "Она ни в чём меня не упрекнула."
    },
    {
     "k": 8,
     "t0": 66.737082,
     "t1": 69.484082,
     "text": "Спрашивала, тепло ли мне, хорошо ли я ем."
    },
    {
     "k": 9,
     "t0": 69.72408200000001,
     "t1": 71.644082,
     "text": "Мы говорили долго, как раньше."
    },
    {
     "k": 10,
     "t0": 72.044082,
     "t1": 74.44408200000001,
     "text": "Я обещал, что теперь буду звонить всегда."
    },
    {
     "k": 11,
     "t0": 74.631082,
     "t1": 76.924082,
     "text": "Через два дня её не стало."
    }
   ],
