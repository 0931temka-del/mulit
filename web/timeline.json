  {
   "i": 3,
   "t0": 37.916735,
   "D": 16.927347,
   "sentences": [
    {
     "k": 1,
     "t0": 37.916735,
     "t1": 41.036735,
     "text": "В четвёртое воскресенье мне стало не по себе, и я позвонил."
    },
    {
     "k": 2,
     "t0": 41.396735,
     "t1": 43.236735,
     "text": "Трубку взяла соседка."
    },
    {
     "k": 3,
     "t0": 43.416735,
     "t1": 44.236735,
     "text": "Это ты?"
    },
    {
     "k": 4,
     "t0": 44.316735,
     "t1": 45.556735,
     "text": "сказала она тихо."
    },
    {
     "k": 5,
     "t0": 45.696735000000004,
     "t1": 48.076735,
     "text": "Она все эти воскресенья ждала у телефона."
    },
    {
     "k": 6,
     "t0": 48.316735,
     "t1": 49.356735,
     "text": "С самого утра."
    },
    {
     "k": 7,
     "t0": 49.636735,
     "t1": 53.116735000000006,
     "text": "Говорила: вдруг он позвонит, а я на кухне."
    },
    {
     "k": 8,
     "t0": 53.356735,
     "t1": 54.796735,
     "text": "Я не помню, что ответил."
    }
   ],
