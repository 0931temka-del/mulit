    {
     "k": 1,
     "t0": 1.0,
     "t1": 4.6,
     "text": "Когда я уезжал, бабушка стояла у калитки и держала меня за рукав."
    },
    {
     "k": 2,
     "t0": 5.04,
     "t1": 7.56,
     "text": "Звони мне по воскресеньям, — сказала она."
    },
    {
     "k": 3,
     "t0": 7.88,
     "t1": 10.04,
     "text": "Просто чтобы я слышала голос."
    },
    {
     "k": 4,
     "t0": 10.56,
     "t1": 11.88,
     "text": "Я пообещал."
    },
    {
     "k": 5,
     "t0": 12.06,
     "t1": 13.4,
     "text": "Это было легко."
    }
   ],
