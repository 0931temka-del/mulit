  {
   "i": 2,
   "t0": 14.434286,
   "D": 22.282449,
   "sentences": [
    {
     "k": 1,
     "t0": 14.434286,
     "t1": 16.034286,
     "text": "Первые месяцы я звонил."
    },
    {
     "k": 2,
     "t0": 16.174286,
     "t1": 21.634286,
     "text": "Потом появились работа, друзья, чужой язык, который никак не становился своим."
    },
    {
     "k": 3,
     "t0": 21.914286,
     "t1": 24.434286,
     "text": "Воскресенья начали заполняться."
    },
    {
     "k": 4,
     "t0": 24.634286,
     "t1": 27.194285999999998,
     "text": "«Позвоню в следующий раз», — думал я."
    },
    {
     "k": 5,
     "t0": 27.414286,
     "t1": 28.274286,
     "text": "Один раз."
    },
    {
     "k": 6,
     "t0": 28.554285999999998,
     "t1": 29.634286,
     "text": "Второй."
    },
    {
     "k": 7,
     "t0": 29.834286,
     "t1": 30.514286,
     "text": "Третий."
    },
    {
     "k": 8,
     "t0": 30.874286,
     "t1": 33.394286,
     "text": "Три недели я не набирал её номер."
    },
    {
     "k": 9,
     "t0": 33.554286000000005,
     "t1": 36.674285999999995,
     "text": "Каждый раз находилась причина, и каждая казалась важной."
    }
   ],
