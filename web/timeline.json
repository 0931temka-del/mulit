   "t0": 78.468164,
   "D": 17.319184,
   "sentences": [
    {
     "k": 1,
     "t0": 78.468164,
     "t1": 82.548164,
     "text": "Теперь каждое воскресенье я сажусь у окна и набираю её номер."
    },
    {
     "k": 2,
     "t0": 82.948164,
     "t1": 84.948164,
     "text": "Я знаю, что никто не ответит."
    },
    {
     "k": 3,
     "t0": 85.241164,
     "t1": 87.188164,
     "text": "Но я слушаю гудки."
    },
    {
     "k": 4,
     "t0": 87.548164,
     "t1": 88.628164,
     "text": "Один."
    },
    {
     "k": 5,
     "t0": 88.788164,
     "t1": 89.908164,
     "text": "Второй."
    },
    {
     "k": 6,
     "t0": 90.108164,
     "t1": 90.86816400000001,
     "text": "Третий."
    },
    {
     "k": 7,
     "t0": 91.228164,
     "t1": 95.748164,
     "text": "И держу трубку, пока хватает сил, — на случай, если она всё-таки ждёт."
